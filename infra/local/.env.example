AGENT_CORE_DATABASE_APP_URL=postgresql://sires_agent_core_app:sires-local@localhost:5432/sires_agent_core
AGENT_CORE_DATABASE_SYSTEM_URL=postgresql://sires_agent_core_system:sires-local@localhost:5432/sires_agent_core
