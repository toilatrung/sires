# Copy to .env for local overrides. Local-only credentials; never reuse elsewhere.
# pnpm local:migrate và pnpm local:services đọc file này, ghi đè bằng infra/local/.env (không commit) rồi biến của shell.
POSTGRES_URL=postgres://sires:sires-local@localhost:5432
RABBITMQ_URL=amqp://guest:guest@localhost:5672
S3_ENDPOINT=http://localhost:9000

# Khóa cục bộ, chỉ cho máy phát triển. Để trống: lần chạy đầu sinh ngẫu nhiên và ghi vào infra/local/.env.
# IDENTITY_LOCAL_KEK: base64 của 32 byte (openssl rand -base64 32); đổi KEK thì DEK đã bọc không mở được nữa.
IDENTITY_LOCAL_KEK=
IDENTITY_LOCAL_KEK_ID=local-kek-1
# SERVICE_AUTH_DEV_SEED: ít nhất 16 ký tự, mọi service dùng chung để có cùng bộ khóa service-to-service.
SERVICE_AUTH_DEV_SEED=
LOG_ACCOUNT_HASH_KEY=
# GATEWAY_CSRF_KEY: 64 ký tự hex (PID-00014).
GATEWAY_CSRF_KEY=

# DSN theo service (vai trò của infra/local/postgres/init/02-roles.sql, mật khẩu sires-local). Mỗi tiến trình đọc
# DATABASE_APP_URL, DATABASE_SYSTEM_URL, DATABASE_MIGRATOR_URL không tiền tố: local:services đặt _APP, _SYSTEM và
# local:migrate đặt _MIGRATOR cho từng service từ các dòng <SERVICE>_ dưới đây.
GATEWAY_DATABASE_APP_URL=postgresql://sires_gateway_app:sires-local@localhost:5432/sires_gateway
GATEWAY_DATABASE_SYSTEM_URL=postgresql://sires_gateway_system:sires-local@localhost:5432/sires_gateway
GATEWAY_DATABASE_MIGRATOR_URL=postgresql://sires_gateway_migrator:sires-local@localhost:5432/sires_gateway
IDENTITY_DATABASE_APP_URL=postgresql://sires_identity_app:sires-local@localhost:5432/sires_identity
IDENTITY_DATABASE_SYSTEM_URL=postgresql://sires_identity_system:sires-local@localhost:5432/sires_identity
IDENTITY_DATABASE_MIGRATOR_URL=postgresql://sires_identity_migrator:sires-local@localhost:5432/sires_identity
WORKSPACE_DATABASE_APP_URL=postgresql://sires_workspace_app:sires-local@localhost:5432/sires_workspace
WORKSPACE_DATABASE_SYSTEM_URL=postgresql://sires_workspace_system:sires-local@localhost:5432/sires_workspace
WORKSPACE_DATABASE_MIGRATOR_URL=postgresql://sires_workspace_migrator:sires-local@localhost:5432/sires_workspace
PLANNING_DATABASE_APP_URL=postgresql://sires_planning_app:sires-local@localhost:5432/sires_planning
PLANNING_DATABASE_SYSTEM_URL=postgresql://sires_planning_system:sires-local@localhost:5432/sires_planning
PLANNING_DATABASE_MIGRATOR_URL=postgresql://sires_planning_migrator:sires-local@localhost:5432/sires_planning
ORCHESTRATION_DATABASE_APP_URL=postgresql://sires_orchestration_app:sires-local@localhost:5432/sires_orchestration
ORCHESTRATION_DATABASE_SYSTEM_URL=postgresql://sires_orchestration_system:sires-local@localhost:5432/sires_orchestration
ORCHESTRATION_DATABASE_MIGRATOR_URL=postgresql://sires_orchestration_migrator:sires-local@localhost:5432/sires_orchestration
LIBRARY_DATABASE_APP_URL=postgresql://sires_library_app:sires-local@localhost:5432/sires_library
LIBRARY_DATABASE_SYSTEM_URL=postgresql://sires_library_system:sires-local@localhost:5432/sires_library
LIBRARY_DATABASE_MIGRATOR_URL=postgresql://sires_library_migrator:sires-local@localhost:5432/sires_library
RESEARCH_DATABASE_APP_URL=postgresql://sires_research_app:sires-local@localhost:5432/sires_research
RESEARCH_DATABASE_SYSTEM_URL=postgresql://sires_research_system:sires-local@localhost:5432/sires_research
RESEARCH_DATABASE_MIGRATOR_URL=postgresql://sires_research_migrator:sires-local@localhost:5432/sires_research
MANUSCRIPT_DATABASE_APP_URL=postgresql://sires_manuscript_app:sires-local@localhost:5432/sires_manuscript
MANUSCRIPT_DATABASE_SYSTEM_URL=postgresql://sires_manuscript_system:sires-local@localhost:5432/sires_manuscript
MANUSCRIPT_DATABASE_MIGRATOR_URL=postgresql://sires_manuscript_migrator:sires-local@localhost:5432/sires_manuscript
AUDIT_DATABASE_APP_URL=postgresql://sires_audit_app:sires-local@localhost:5432/sires_audit
AUDIT_DATABASE_SYSTEM_URL=postgresql://sires_audit_system:sires-local@localhost:5432/sires_audit
