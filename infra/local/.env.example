KNOWLEDGE_DATABASE_APP_URL=postgresql://sires_knowledge_app:sires-local@localhost:5432/sires_knowledge
KNOWLEDGE_DATABASE_SYSTEM_URL=postgresql://sires_knowledge_system:sires-local@localhost:5432/sires_knowledge
