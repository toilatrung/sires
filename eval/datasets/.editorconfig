# CSV ở đây mở bằng Excel: cần BOM UTF-8 để Excel hiển thị đúng tiếng Việt và CRLF như Excel tự lưu.
[*.csv]
charset = utf-8-bom
end_of_line = crlf
trim_trailing_whitespace = false
