{
  "name": "eval",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "eval/src",
  "tags": [
    "type:eval",
    "lang:python",
    "scope:eval"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "eval",
        "command": "uv run ruff check ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "eval",
        "command": "uv run mypy src"
      }
    }
  }
}
