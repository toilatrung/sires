{
  "name": "agent-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/agent-core/src",
  "tags": [
    "type:app",
    "lang:python",
    "scope:agent-core"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/agent-core",
        "command": "uv run uvicorn agent_core.main:app --reload --port 8101"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/agent-core",
        "command": "uv run ruff check ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/agent-core",
        "command": "uv run mypy src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/agent-core",
        "command": "uv run pytest"
      }
    }
  }
}
