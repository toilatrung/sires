{
  "name": "knowledge",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/knowledge/src",
  "tags": [
    "type:app",
    "lang:python",
    "scope:knowledge"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/knowledge",
        "command": "uv run uvicorn knowledge.main:app --reload --port 8102"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/knowledge",
        "command": "uv run ruff check ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/knowledge",
        "command": "uv run mypy src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/knowledge",
        "command": "uv run pytest"
      }
    }
  }
}
