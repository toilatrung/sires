{
  "name": "@sires/audit",
  "version": "0.0.0",
  "private": true,
  "description": "SIRes audit service (NestJS)",
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@sires/contracts": "workspace:*",
    "@sires/platform": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@sires/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": ["build"],
        "inputs": ["default", "^default", "{workspaceRoot}/docs/database/ddl/00-common.sql", "{workspaceRoot}/docs/database/ddl/audit.sql"]
      }
    },
    "tags": [
      "type:app",
      "lang:ts",
      "scope:audit"
    ]
  }
}
