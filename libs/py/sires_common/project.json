{
  "name": "sires-common",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/py/sires_common/src",
  "tags": [
    "type:lib",
    "lang:python",
    "scope:platform"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/py/sires_common",
        "command": "uv run ruff check ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/py/sires_common",
        "command": "uv run python -m mypy src"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "libs/py/sires_common",
        "command": "uv run python -m pytest"
      }
    }
  }
}
