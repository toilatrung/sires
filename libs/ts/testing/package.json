{
  "name": "@sires/testing",
  "version": "0.0.0",
  "private": true,
  "description": "SIRes shared test fakes and containers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@sires/contracts": "workspace:*",
    "@testcontainers/minio": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@testcontainers/rabbitmq": "catalog:",
    "testcontainers": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "amqplib": "catalog:",
    "minio": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:lib",
      "lang:ts",
      "scope:platform"
    ]
  }
}
