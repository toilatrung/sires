{
  "name": "@sires/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Types and clients generated from OpenAPI and AsyncAPI contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:ts": "node scripts/generate.mjs --ts-only",
    "generate:python": "node scripts/generate.mjs --python-only",
    "test": "node --test scripts/generate.spec.mjs scripts/check-drift.spec.mjs",
    "check-drift": "node scripts/check-drift.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "tags": [
      "type:lib",
      "lang:ts",
      "scope:contracts"
    ],
    "targets": {
      "check-drift": {
        "cache": false
      },
      "generate": {
        "executor": "nx:noop",
        "dependsOn": [
          "generate-ts",
          "generate-python"
        ]
      },
      "generate-ts": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node libs/ts/contracts/scripts/generate.mjs --ts-only"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/docs/api-design/**/*.yaml",
          "{projectRoot}/scripts/**/*"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ]
      },
      "generate-python": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node libs/ts/contracts/scripts/generate.mjs --python-only"
        },
        "cache": true,
        "inputs": [
          "{workspaceRoot}/docs/api-design/**/*.yaml",
          "{projectRoot}/scripts/**/*"
        ],
        "outputs": [
          "{workspaceRoot}/libs/py/sires_common/src/sires_common/generated"
        ]
      },
      "build": {
        "dependsOn": [
          "generate-ts"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "generate-ts"
        ]
      }
    }
  }
}
