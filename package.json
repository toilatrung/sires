{
  "name": "sires",
  "version": "0.0.0",
  "private": true,
  "description": "SIRes monorepo: web, NestJS services, Python agent core",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "affected": "nx affected -t lint typecheck test build",
    "contracts:generate": "nx run @sires/contracts:generate",
    "check:tracks": "node scripts/development/check-tracks.mjs",
    "local:up": "node scripts/development/local-env.mjs up",
    "local:down": "node scripts/development/local-env.mjs down"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
